// Resources of "Zax Editor.exe" (tools/package/starter.c): the icon (rendered at build time from the editor's own
// drawing, tools/package/make_icon.py) and the version information.
#include <windows.h>

1 ICON "ZaxEditor.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Zax Editor"
            VALUE "ProductName", "Zax Editor"
            VALUE "OriginalFilename", "Zax Editor.exe"
            VALUE "LegalCopyright", "MIT licence; see LICENSE.txt"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
